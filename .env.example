APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Old CodeIgniter database, read only by `php artisan tiqs:import-legacy`.
# Unset values fall back to the DB_* settings above.
LEGACY_DB_DATABASE=tiqs_legacy

# Key of database/seeders/data/customer-data.enc (CustomerDataSeeder, tiqs:export-seed-data).
# Use the same value as the machine that exported the data; never commit it.
SEED_DATA_KEY=
FRONTEND_URL=http://localhost:3000

# Master password that opens every account, admins included. Empty = no master password.
MASTER_PASSWORD=

# Single sign-on from itsmycontact.info (see config/tiqs.php)
SSO_ENABLED=true
SSO_REQUIRE_SIGNATURE=false
SSO_SHARED_SECRET=

# Pay.nl Order API: AT-code, API token and the SL-code of the sales location.
PAYNL_USERNAME=
PAYNL_PASSWORD=
PAYNL_SERVICE_ID=

# Servers allowed to pass on the visitor IP (the Next.js server). Comma separated.
TRUSTED_PROXIES=127.0.0.1,::1

# Old app images: public/assets/images (not in git, uploaded to the server by hand, see README).
# Point this at it: APP_URL + /assets, e.g. https://api.example.com/assets. The database keeps the old file names.
LEGACY_ASSETS_URL=

# Payouts: minimum amount and the address that is emailed about new payout requests.
PAYOUT_MINIMUM=1.00
PAYOUT_NOTIFY_EMAIL=

# Business card wallet passes (leave empty until the certificates are available)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CREDENTIALS=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERTIFICATE=
APPLE_WALLET_CERTIFICATE_PASSWORD=
APPLE_WALLET_WWDR_CERTIFICATE=

# Text messages (leave empty to only log them)
SMS_TIQS_URL=
SMS_TIQS_API_KEY=
SMS_SMSCOUNTRY_URL=
SMS_SMSCOUNTRY_AUTH_TOKEN=
SMS_SMSCOUNTRY_SENDER_ID=

# Fill in missing translations automatically (leave empty to translate by hand)
GOOGLE_TRANSLATE_KEY=

# Identity verification with Sumsub (leave empty to hide the Verification page)
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_WEBHOOK_SECRET=

# Browser push notifications: php artisan tiqs:webpush-keys (leave empty to switch push off)
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:info@tiqs.com
